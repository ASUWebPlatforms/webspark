/**
 * Install ASU Data Potluck module.
 */
function asu_degree_rfi_update_10000(&$sandbox) {
  if (!Drupal::moduleHandler()->moduleExists('asu_data_potluck')) {
    Drupal::service('module_installer')->install(['asu_data_potluck']);
  }
}

/**
 * Set new default global setting for RFI form variant to 2 pager.
 */
function asu_degree_rfi_update_10001(&$sandbox) {
  $rfi_variant_global_default = 'rfiVariant2';
  $config = \Drupal::configFactory()->getEditable('asu_degree_rfi.settings');
  $config->set('asu_degree_rfi.rfi_variant_default', $rfi_variant_global_default);
  $config->save();

  \Drupal::state()->set('configuration_locked', FALSE);
  \Drupal::service('webspark.config_manager')->updateConfigFile('core.entity_view_display.node.degree_detail_page.default');
  \Drupal::state()->set('configuration_locked', TRUE);
}

/**
 * Add Breadcrumbs to Degree Listing pages.
 */
function asu_degree_rfi_update_10002(&$sandbox) {
  \Drupal::state()->set('configuration_locked', FALSE);
  \Drupal::service('webspark.config_manager')->importConfigFile('field.field.node.degree_listing_page.field_degree_detail_breadcrumbs');
  \Drupal::service('webspark.config_manager')->updateConfigFile('core.entity_form_display.node.degree_listing_page.default');
  \Drupal::service('webspark.config_manager')->updateConfigFile('core.entity_view_display.node.degree_listing_page.teaser');
  \Drupal::service('webspark.config_manager')->updateConfigFile('core.entity_view_display.node.degree_listing_page.default');
  \Drupal::state()->set('configuration_locked', TRUE);
}

/**
 * Update RFI submission handler URL to new endpoints.
 */
function asu_degree_rfi_update_10004(&$sandbox) {
  $config = \Drupal::configFactory()->getEditable('asu_degree_rfi.settings');
  $current_url = $config->get('asu_degree_rfi.rfi_submission_handler_url');

  //Remove trailing slash if exists to handle URLs both with and without trailing slash
  $normalized_url = rtrim($current_url, '/');

  $endpoint_map = [
    'https://5gu33wnsdm2mpgmob4c2rt3mbq0mngfo.lambda-url.us-west-2.on.aws' => 'https://crm-request-form-submission-router-prod.apps.asu.edu/v1/event/rfi',
    'https://eakemwmmmpql5o523dnfkvvtem0ezhhc.lambda-url.us-west-2.on.aws' => 'https://crm-request-form-submission-router-qa.apps.asu.edu/v1/event/rfi',
    'https://3ceccsb54wpba5wrdg6kgxmlv40obcjl.lambda-url.us-west-2.on.aws' => 'https://crm-request-form-submission-router-dev.apps.asu.edu/v1/event/rfi',
  ];

  if (isset($endpoint_map[$normalized_url])) {
    $config->set('asu_degree_rfi.rfi_submission_handler_url', $endpoint_map[$normalized_url]);
    $config->save();
  }
}

/**
 * Unpublish all degree detail pages and add offsite degree redirects.
 *
 * For every degree_detail_page node the academic plan code is looked up against
 * the Data Potluck Academic Plan codeset to determine the program type
 * (bachelors, masters-phd or minors). A guarded 301 redirect is created from
 * the node's public path to the offsite degree page and the node is then
 * unpublished. The hook is batched and idempotent: it can be safely re-run, and
 * nodes whose program type cannot be resolved are left untouched for follow-up.
 */
function asu_degree_rfi_update_10005(&$sandbox) {
  // The redirect logic depends on the redirect module.
  if (!\Drupal::moduleHandler()->moduleExists('redirect')) {
    \Drupal::service('module_installer')->install(['redirect']);
  }

  /** @var \Drupal\asu_degree_rfi\AsuDegreeRfiDegreeRedirector $redirector */
  $redirector = \Drupal::service('asu_degree_rfi.degree_redirector');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  // Initialise the batch on the first pass.
  if (!isset($sandbox['nids'])) {
    $sandbox['nids'] = $redirector->getDegreeDetailNids();
    $sandbox['total'] = count($sandbox['nids']);
    $sandbox['processed'] = 0;
    $sandbox['counts'] = [
      'redirected' => 0,
      'redirect_exists' => 0,
      'skipped_no_plancode' => 0,
      'skipped_no_type' => 0,
    ];
  }

  if ($sandbox['total'] == 0) {
    $sandbox['#finished'] = 1;
    return t('No degree detail pages found; nothing to do.');
  }

  // Process a limited number of nodes per pass to bound external API calls and
  // memory usage during the deployment.
  $batch_size = 25;
  $chunk = array_slice($sandbox['nids'], $sandbox['processed'], $batch_size);

  foreach ($node_storage->loadMultiple($chunk) as $node) {
    $result = $redirector->processNode($node);
    if (isset($sandbox['counts'][$result])) {
      $sandbox['counts'][$result]++;
    }
    $sandbox['processed']++;
  }

  $sandbox['#finished'] = $sandbox['processed'] >= $sandbox['total'] ? 1 : ($sandbox['processed'] / $sandbox['total']);

  if ($sandbox['#finished'] === 1) {
    return t('Processed @total degree detail pages: @redirected redirected, @existing already had a redirect, @no_plancode skipped (no plan code), @no_type skipped (unresolved program type).', [
      '@total' => $sandbox['total'],
      '@redirected' => $sandbox['counts']['redirected'],
      '@existing' => $sandbox['counts']['redirect_exists'],
      '@no_plancode' => $sandbox['counts']['skipped_no_plancode'],
      '@no_type' => $sandbox['counts']['skipped_no_type'],
    ]);
  }
}

function _asu_degree_rfi_revert_all_module_config() {
  // Get this module name.
  $module = \Drupal::service('module_handler')
    ->getModule(basename(__FILE__, '.install'))
    ->getName();
  // Unlock the configuration storage.
  \Drupal::state()->set('configuration_locked', FALSE);
  // Revert all configs from this module.
  \Drupal::service('webspark.config_manager')->revertAll($module);
  // Lock the configuration storage.
  \Drupal::state()->set('configuration_locked', TRUE);
}
